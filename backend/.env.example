# NIDHI TRACE Backend Configuration

# Database (defaults to local SQLite nidhitrace.db if omitted)
DATABASE_URL=sqlite:///nidhitrace.db
# Or PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/nidhitrace

# AI Audit Copilot
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_MODEL=moonshotai/kimi-k3
ASSISTANT_RATE_LIMIT_PER_MINUTE=20
ASSISTANT_RATE_LIMIT_PER_HOUR=200
