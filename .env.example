# NIDHI TRACE - Environment Configuration

# NVIDIA Cloud Functions / NIM API Key for Kimi-K3 (server-side only, NEVER exposed to client)
# Get your API key from: https://build.nvidia.com/
NVIDIA_API_KEY=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

# LLM Model Name (Default: moonshotai/kimi-k3)
NVIDIA_MODEL=moonshotai/kimi-k3

# Assistant Rate Limiting (Requests per IP/session)
ASSISTANT_RATE_LIMIT_PER_MINUTE=10
ASSISTANT_RATE_LIMIT_PER_HOUR=100

# Input & Output Limits
MAX_MESSAGE_LENGTH=2000
MAX_CONVERSATION_TURNS=6
MAX_OUTPUT_TOKENS=800
NVIDIA_TIMEOUT_SECONDS=30

# Server Port
PORT=3000
